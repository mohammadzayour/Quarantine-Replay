# Optional settings. Copy to .env if you want to change a default. Never commit .env.
# The fixture demo needs none of this, and the default live mode needs no key.

# --- Live model: local Ollama (default, free, runs on this machine) ---
# QR_OLLAMA_MODEL=qwen3:4b
# QR_OLLAMA_HOST=http://127.0.0.1:11434

# --- Live model: Anthropic API (paid, off unless you opt in here) ---
# An API key alone does NOT switch this on. Both lines are required.
# QR_LIVE_PROVIDER=anthropic
# ANTHROPIC_API_KEY=
# QR_LIVE_MODEL=claude-opus-5-5
# QR_LIVE_FALLBACKS=1

# Port for `python -m app` (default 8000)
# QR_PORT=8000
